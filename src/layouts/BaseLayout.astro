---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';

interface Props {
  title: string;
  description: string;
  /** Which nav item is current — used to highlight in <Header /> */
  activePage?: 'home' | 'about' | 'services' | 'bridal' | 'contact';
  /** Optional OG image URL (defaults to brand hero) */
  ogImage?: string;
}

const {
  title,
  description,
  activePage,
  ogImage = '/about-romy-left4.jpeg',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Flag JS early so scroll-reveal hidden states only apply when JS can un-hide them (no FOUC, graceful no-JS fallback) -->
  <script is:inline>document.documentElement.classList.add('js');</script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="Romy Salon & Spa" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Favicon — Romy's actual logo, served locally -->
  <link rel="icon" type="image/png" href="/logo5.png" />
  <link rel="apple-touch-icon" href="/logo5.png" />
  <!-- Fallback: branded SVG monogram -->
  <link rel="alternate icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Montserrat:wght@300;400;500;600;700&family=Open+Sans:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />

  <!-- Expanded LocalBusiness + Person + Service Schema for AEO/GEO citability -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': ['HairSalon', 'BeautySalon', 'DaySpa'],
    '@id': 'https://romysalon.com/#business',
    'name': 'Romy Salon & Spa',
    'alternateName': 'Romy Salon',
    'description': "Old Town Fairfax's master-stylist-led luxury hair color, balayage, fantasy color, facial, nail design, head spa massage and bridal salon. By appointment with limited walk-ins.",
    'image': ['/about-romy-left4.jpeg', '/about-romy-left.jpeg', '/SPA.jpg'],
    'logo': '/logo5.png',
    'telephone': '+15714075801',
    'email': 'info@romysalon.com',
    'url': 'https://romy-salon-site.vercel.app',
    'address': {
      '@type': 'PostalAddress',
      'streetAddress': '3950 University Drive, Suite 211',
      'addressLocality': 'Fairfax',
      'addressRegion': 'VA',
      'postalCode': '22030',
      'addressCountry': 'US'
    },
    'geo': {'@type':'GeoCoordinates','latitude':38.847302,'longitude':-77.305151},
    'hasMap': 'https://maps.google.com/?q=3950+University+Drive+Fairfax+VA+22030',
    'areaServed': [
      {'@type':'City','name':'Fairfax'},{'@type':'City','name':'Vienna'},{'@type':'City','name':'Oakton'},
      {'@type':'City','name':'Fairfax Station'},{'@type':'City','name':'Burke'},{'@type':'City','name':'Centreville'},
      {'@type':'City','name':'Reston'},{'@type':'City','name':'Arlington'},
      {'@type':'AdministrativeArea','name':'Northern Virginia'}
    ],
    'openingHoursSpecification': [
      {'@type':'OpeningHoursSpecification','dayOfWeek':['Monday','Tuesday','Wednesday','Thursday'],'opens':'10:00','closes':'19:00'},
      {'@type':'OpeningHoursSpecification','dayOfWeek':['Friday','Saturday'],'opens':'09:00','closes':'19:00'},
      {'@type':'OpeningHoursSpecification','dayOfWeek':'Sunday','opens':'12:00','closes':'17:00'}
    ],
    'priceRange': '$$$',
    'paymentAccepted': 'Cash, Credit Card, Debit Card, Apple Pay, Google Pay',
    'currenciesAccepted': 'USD',
    'foundingDate': '2025',
    'founder': {
      '@type': 'Person',
      '@id': 'https://romysalon.com/#romy',
      'name': 'Romy',
      'jobTitle': 'Master Stylist & Color Theorist',
      'description': 'Master Stylist with 15+ years of experience specializing in custom color, balayage, fantasy color, silver/platinum tones, and color correction.',
      'image': '/about-romy-left.jpeg',
      'sameAs': ['https://www.instagram.com/romy_salonandspa/','https://www.tiktok.com/@romysalonandspa']
    },
    'aggregateRating': {'@type':'AggregateRating','ratingValue':'5.0','reviewCount':'44','bestRating':'5'},
    'hasOfferCatalog': {
      '@type': 'OfferCatalog',
      'name': 'Salon & Spa Services',
      'itemListElement': [
        {'@type':'Offer','itemOffered':{'@type':'Service','name':'Custom Color & Balayage','description':'Hand-painted custom color, balayage, fantasy shades. Olaplex bond-builder included.'},'price':'185','priceCurrency':'USD'},
        {'@type':'Offer','itemOffered':{'@type':'Service','name':'Color Correction','description':'Multi-step color correction by master stylist. Consultation required.'},'price':'350','priceCurrency':'USD'},
        {'@type':'Offer','itemOffered':{'@type':'Service','name':'Master Haircut & Style','description':'Precision cut with consultation, shampoo, and finishing blowout.'},'price':'95','priceCurrency':'USD'},
        {'@type':'Offer','itemOffered':{'@type':'Service','name':'Signature Facial','description':'Customized 90-minute facial with extractions, mask, and LED therapy.'},'price':'269','priceCurrency':'USD'},
        {'@type':'Offer','itemOffered':{'@type':'Service','name':'Head Spa Massage','description':'Restorative scalp, neck, and shoulder treatment with aromatherapy.'},'price':'135','priceCurrency':'USD'},
        {'@type':'Offer','itemOffered':{'@type':'Service','name':'Bridal Hair & Makeup','description':'Bride trial plus day-of styling. Bridal party and on-location available.'},'price':'625','priceCurrency':'USD'}
      ]
    },
    'knowsAbout': ['Balayage','Hair Color','Color Correction','Fantasy Color','Silver Hair','Platinum Blonde','Bridal Hair','Quinceañera Makeup','Olaplex','HydraFacial','Head Spa Massage','Lash Extensions','Gel-X Nails','Swarovski Crystal Nail Art'],
    'sameAs': [
      'https://www.instagram.com/romy_salonandspa/',
      'https://www.facebook.com/Romyhairandmakeup/',
      'https://www.tiktok.com/@romysalonandspa',
      'https://www.yelp.com/biz/romy-salon-and-spa-fairfax'
    ]
  })} />
</head>
<body>
  <TopBar />
  <Header activePage={activePage} />
  <main>
    <slot />
  </main>
  <Footer />
  <StickyMobileCTA />

  <!-- Scroll reveal: gentle fade + rise as content scrolls into view -->
  <script is:inline>
    (() => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // Section-level building blocks tagged across the whole site.
      const SELECTORS = [
        '.section-eyebrow', '.section-h', '.section-sub', '.ornament',
        '.services-grid', '.master-photo', '.master-content',
        '.ritual-stages', '.ritual-cta',
        '.transform-grid', '.transform-disclaimer', '.transform-cta',
        '.lookbook-grid', '.lookbook-cta', '.video-grid',
        '.reviews-grid', '.bridal-content', '.bridal-photo',
        '.location-content', '.location-photo',
        '.news-form', '.ig-grid',
        '.reveal'
      ];
      const nodes = new Set();
      SELECTORS.forEach((sel) => document.querySelectorAll(sel).forEach((n) => nodes.add(n)));

      const vh = window.innerHeight || document.documentElement.clientHeight;
      const toObserve = [];
      nodes.forEach((el) => {
        el.classList.add('reveal');
        // Anything already in view on load: show immediately (protects LCP / above-the-fold).
        const top = el.getBoundingClientRect().top;
        if (reduce || top < vh * 0.92) {
          el.classList.add('in');
        } else {
          toObserve.push(el);
        }
      });

      if (reduce || !('IntersectionObserver' in window)) {
        toObserve.forEach((el) => el.classList.add('in'));
        return;
      }

      const io = new IntersectionObserver((entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            obs.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });

      toObserve.forEach((el) => io.observe(el));
    })();
  </script>
</body>
</html>
