---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Bridal & Wedding Hair, Makeup & Styling | Romy Salon & Spa · Fairfax VA"
  description="Bridal hair, makeup, and on-location styling for weddings in Northern Virginia. Trial + day-of services, bridal party packages, quinceañera artistry."
  activePage="bridal"
>

<!-- HERO -->
<section class="bridal-hero">
  <div class="grid">
    <div class="photo"></div>
    <div class="content">
      <div class="breadcrumb"><a href="/">Home</a> / Bridal</div>
      <h1>For the most <span class="italic">photographed</span> day of your life</h1>
      <p>Hair, makeup, and bridal styling crafted with the same precision we bring to every chair — built around the bride, her party, and the timeline.</p>
      <div>
        <a href="#inquire" class="btn lg gold">Inquire About Your Date</a>
        <a href="https://booking.mangomint.com/romysalonandspa" target="_blank" rel="noopener" class="btn lg ghost" style="margin-left:8px">Book a Trial</a>
      </div>
    </div>
  </div>
</section>

<!-- PACKAGES -->
<section class="pkg-section">
  <div class="wrap">
    <div class="section-eyebrow">Bridal Packages</div>
    <h2 class="section-h">Three ways to <span class="italic">begin</span></h2>
    <div class="ornament"></div>
    <p class="section-sub">Each package can be customized. On-location available within 30 minutes of Old Town Fairfax. Travel beyond by quote.</p>

    <div class="pkg-grid">
      <div class="pkg-card">
        <div class="name">The <span class="italic">Bride</span></div>
        <div class="sub">— Trial + Day-Of</div>
        <div class="price">$625</div>
        <div class="price-sub">Approx. 4 hours total</div>
        <ul>
          <li>90-min bridal trial (worn home)</li>
          <li>Day-of hair + makeup at the salon</li>
          <li>Touch-up kit to take with you</li>
          <li>Photography permission requested</li>
          <li>Includes complimentary champagne</li>
        </ul>
        <a href="#inquire" class="btn">Inquire</a>
      </div>

      <div class="pkg-card featured">
        <div class="name">The <span class="italic">Bridal Party</span></div>
        <div class="sub">— Bride + 4 Guests</div>
        <div class="price">$1,425</div>
        <div class="price-sub">Approx. 6 hours · private styling room</div>
        <ul>
          <li>Everything in The Bride, plus:</li>
          <li>Hair + light makeup for 4 guests</li>
          <li>Private styling room reserved for your party</li>
          <li>Mimosa + light brunch service</li>
          <li>Group polaroid printed + framed</li>
          <li>Optional flower crowns or accessories</li>
        </ul>
        <a href="#inquire" class="btn gold">Inquire</a>
      </div>

      <div class="pkg-card">
        <div class="name">The <span class="italic">On-Location</span></div>
        <div class="sub">— We Come to You</div>
        <div class="price">$1,850+</div>
        <div class="price-sub">Bride + up to 6 guests · custom quote</div>
        <ul>
          <li>Romy + 1 assistant on-location</li>
          <li>Complete kit + portable lighting</li>
          <li>Up to 6 hours of service time</li>
          <li>Travel within 30 mi of Fairfax included</li>
          <li>Stay-through service for last-look touchups</li>
        </ul>
        <a href="#inquire" class="btn">Request Quote</a>
      </div>
    </div>
  </div>
</section>

<!-- GALLERY -->
<section class="gallery-section">
  <div class="wrap">
    <div class="section-eyebrow">Real Brides</div>
    <h2 class="section-h">A selection from the <span class="italic">aisle</span></h2>
    <div class="ornament"></div>
    <p class="section-sub">Each image is a real client. Many more on our Instagram.</p>

    <div class="gallery">
      <div class="item tall"><img src="/transformation-red.jpg" alt="Dramatic red bridal transformation" loading="lazy"></div>
      <div class="item"><img src="/projectHair4.jpg" alt="Romantic balayage waves" loading="lazy"></div>
      <div class="item"><img src="/fantasy10.jpg" alt="Vivid copper bridal color" loading="lazy"></div>
      <div class="item wide"><img src="/projectHair3.jpg" alt="Caramel balayage styling" loading="lazy"></div>
      <div class="item"><img src="/blondes4.jpg" alt="Platinum blonde waves" loading="lazy"></div>
      <div class="item"><img src="/ProjectHair.jpeg" alt="Dimensional highlights" loading="lazy"></div>
      <div class="item"><img src="/unias3.webp" alt="Bridal pink ombre nails" loading="lazy"></div>
    </div>
  </div>
</section>

<!-- PROCESS -->
<section class="process-section">
  <div class="wrap">
    <div class="section-eyebrow">The Process</div>
    <h2 class="section-h">From inquiry to <span class="italic">"I do"</span></h2>
    <div class="ornament"></div>
    <p class="section-sub">A simple, calm, communicative process — built so the bride never has to chase us.</p>

    <div class="process-list">
      <div class="step">
        <div class="num">I.</div>
        <div class="body">
          <h4>Inquiry &amp; Date Hold</h4>
          <p>Submit the form below with your date and venue. We reply within 24 hours with availability. A 25% deposit holds your date.</p>
        </div>
      </div>
      <div class="step">
        <div class="num">II.</div>
        <div class="body">
          <h4>Trial Appointment</h4>
          <p>Scheduled 4–8 weeks before your wedding. We test two looks, photograph them in different lighting, and lock the final direction.</p>
        </div>
      </div>
      <div class="step">
        <div class="num">III.</div>
        <div class="body">
          <h4>Pre-Wedding Confirmation</h4>
          <p>One week out, we confirm timeline, location, and any last details. You get a written timeline you can share with your planner.</p>
        </div>
      </div>
      <div class="step">
        <div class="num">IV.</div>
        <div class="body">
          <h4>Day-Of Service</h4>
          <p>We arrive (or you arrive) on time, set up, and execute. Calm, quiet, professional. We stay through last-look touchups when needed.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- TESTIMONIALS -->
<section class="testimonials-section">
  <div class="wrap">
    <div class="section-eyebrow">From Past Brides</div>
    <h2 class="section-h">Kind <span class="italic">words</span></h2>
    <div class="ornament"></div>

    <div class="testi-grid">
      <div class="testi">
        <blockquote>Romy did my bridal trial and I knew within 10 minutes she understood exactly what I wanted. The day-of, my hair didn't move once — and I have very fine, slippery hair. Worth every penny.</blockquote>
        <div class="name">— Sarah K.</div>
        <div class="venue">MARRIED AT WESTWOOD COUNTRY CLUB · OCT 2025</div>
      </div>
      <div class="testi">
        <blockquote>We brought Romy on-location for my quinceañera. She did my hair and four of my friends' — all on time, all gorgeous, all calm. My mom cried. Best decision we made for the whole event.</blockquote>
        <div class="name">— Isabella R.</div>
        <div class="venue">QUINCEAÑERA AT FAIRFAX GOLF CLUB · MAR 2026</div>
      </div>
    </div>
  </div>
</section>

<!-- INQUIRY FORM -->
<section class="inquiry-section" id="inquire">
  <div class="wrap">
    <div class="section-eyebrow">Tell Us About Your Day</div>
    <h2 class="section-h">Inquire about your <span class="italic">date</span></h2>
    <div class="ornament"></div>
    <p class="section-sub">We respond to bridal inquiries within 24 hours, Monday–Saturday.</p>

    <form class="form-wrap" onsubmit="event.preventDefault();this.innerHTML='<div style=\'text-align:center;padding:60px 0\'><div style=\'font-family:Cormorant Garamond,serif;font-style:italic;font-size:2rem;color:var(--gold-deep);margin-bottom:14px\'>Thank you ❀</div><p style=\'font-family:Cormorant Garamond,serif;font-size:1.2rem;color:var(--ink)\'>We’ll be in touch within 24 hours.</p></div>'">
      <div class="form-row">
        <div>
          <label>Your Name</label>
          <input type="text" required>
        </div>
        <div>
          <label>Email</label>
          <input type="email" required>
        </div>
      </div>
      <div class="form-row">
        <div>
          <label>Phone</label>
          <input type="tel">
        </div>
        <div>
          <label>Wedding Date</label>
          <input type="date" required>
        </div>
      </div>
      <div class="form-row">
        <div>
          <label>Venue / Location</label>
          <input type="text" placeholder="Westwood Country Club, etc.">
        </div>
        <div>
          <label>Party Size (incl. bride)</label>
          <select>
            <option>Just the bride</option>
            <option>2-3 total</option>
            <option>4-6 total</option>
            <option>7-10 total</option>
            <option>10+ total</option>
          </select>
        </div>
      </div>
      <div>
        <label>Tell us about your vision</label>
        <textarea placeholder="Theme, hair length, makeup style, any inspiration photos you'd like to share..."></textarea>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn lg gold">Send Inquiry</button>
      </div>
    </form>
  </div>
</section>

</BaseLayout>

<style>
  /* HERO BRIDAL */
  .bridal-hero{
    background:linear-gradient(135deg, var(--bg-cream) 0%, var(--rose-pale) 100%);
    padding:0;border-bottom:1px solid var(--line);
  }
  .bridal-hero .grid{
    display:grid;grid-template-columns:1fr 1fr;min-height:560px;
  }
  @media(max-width:900px){.bridal-hero .grid{grid-template-columns:1fr}}
  .bridal-hero .photo{
    background:url('/updo5.jpg') center/cover;
    min-height:420px;
  }
  .bridal-hero .content{
    padding:90px 70px;display:flex;flex-direction:column;justify-content:center;
  }
  @media(max-width:900px){.bridal-hero .content{padding:60px 30px}}
  .bridal-hero .breadcrumb{
    font-family:'Montserrat',sans-serif;font-size:10.5px;letter-spacing:0.25em;text-transform:uppercase;
    color:var(--gold-deep);margin-bottom:24px;
  }
  .bridal-hero h1{
    font-family:'Cormorant Garamond',serif;font-size:4rem;font-weight:400;
    line-height:1.05;letter-spacing:-0.01em;margin-bottom:24px;color:var(--ink);
  }
  .bridal-hero h1 .italic{font-style:italic}
  .bridal-hero p{
    font-family:'Cormorant Garamond',serif;font-size:1.35rem;line-height:1.55;
    color:var(--ink);margin-bottom:36px;
  }

  /* PACKAGES */
  .pkg-section{background:var(--bg)}
  .pkg-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;margin-top:30px}
  @media(max-width:900px){.pkg-grid{grid-template-columns:1fr}}
  .pkg-card{
    background:var(--paper);padding:50px 36px;text-align:center;
    box-shadow:0 2px 20px rgba(167,127,142,0.06);transition:all 0.3s;
    border:1px solid var(--line);
  }
  .pkg-card:hover{transform:translateY(-6px);box-shadow:0 16px 40px rgba(167,127,142,0.15)}
  .pkg-card.featured{
    background:linear-gradient(180deg, var(--paper) 0%, var(--rose-pale) 100%);
    border:2px solid var(--gold);position:relative;
  }
  .pkg-card.featured::before{
    content:'\2740 MOST CHOSEN \2740';position:absolute;top:-14px;left:50%;transform:translateX(-50%);
    background:var(--gold);color:var(--ink);padding:6px 18px;
    font-family:'Montserrat',sans-serif;font-size:10px;letter-spacing:0.18em;font-weight:700;
  }
  .pkg-card .name{
    font-family:'Cormorant Garamond',serif;font-size:2rem;font-weight:500;
    color:var(--ink);margin-bottom:6px;
  }
  .pkg-card .name .italic{font-style:italic}
  .pkg-card .sub{
    font-family:'Montserrat',sans-serif;font-size:10px;letter-spacing:0.22em;
    text-transform:uppercase;color:var(--gold-deep);margin-bottom:30px;
  }
  .pkg-card .price{
    font-family:'Cormorant Garamond',serif;font-size:3.4rem;font-style:italic;
    color:var(--ink);line-height:1;margin-bottom:6px;
  }
  .pkg-card .price-sub{
    font-size:12px;color:var(--ink);margin-bottom:32px;
    font-family:'Montserrat',sans-serif;letter-spacing:0.08em;
  }
  .pkg-card ul{list-style:none;padding:0;margin:0 0 32px;text-align:left}
  .pkg-card li{
    padding:10px 0;font-size:14px;color:var(--ink);
    border-bottom:1px dotted var(--line);display:flex;gap:10px;
  }
  .pkg-card li:last-child{border-bottom:0}
  .pkg-card li::before{content:'\2740';color:var(--rose);flex-shrink:0}

  /* GALLERY */
  .gallery-section{
    background:linear-gradient(180deg, var(--bg) 0%, var(--bg-soft) 100%);
  }
  .gallery{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:240px;gap:14px}
  @media(max-width:900px){.gallery{grid-template-columns:repeat(2,1fr);grid-auto-rows:200px}}
  .gallery .item{overflow:hidden}
  .gallery .item img{width:100%;height:100%;object-fit:cover;transition:transform 0.6s}
  .gallery .item:hover img{transform:scale(1.06)}
  .gallery .item.tall{grid-row:span 2}
  .gallery .item.wide{grid-column:span 2}

  /* PROCESS */
  .process-section{background:var(--ink);color:var(--bg);padding:120px 0}
  .process-section .section-eyebrow{color:var(--gold)}
  .process-section .section-h{color:var(--bg)}
  .process-section .section-sub{color:var(--bg);opacity:0.85}
  .process-section .ornament::after{background:var(--ink)}
  .process-list{
    max-width:780px;margin:50px auto 0;
  }
  .step{
    display:grid;grid-template-columns:80px 1fr;gap:30px;
    padding:30px 0;border-bottom:1px solid rgba(214,185,129,0.2);
  }
  .step:last-child{border-bottom:0}
  .step .num{
    font-family:'Cormorant Garamond',serif;font-size:3rem;font-style:italic;
    color:var(--gold);line-height:1;
  }
  .step .body h4{
    font-family:'Cormorant Garamond',serif;font-size:1.5rem;font-weight:500;
    color:var(--bg);margin-bottom:10px;
  }
  .step .body p{color:var(--bg);opacity:0.85;font-size:15px;line-height:1.7}

  /* TESTIMONIALS */
  .testimonials-section{
    background:linear-gradient(180deg, var(--bg-soft) 0%, var(--bg-cream) 100%);
  }
  .testi-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:30px;margin-top:30px}
  @media(max-width:900px){.testi-grid{grid-template-columns:1fr}}
  .testi{
    background:var(--paper);padding:44px 40px;
    box-shadow:0 2px 24px rgba(167,127,142,0.07);position:relative;
  }
  .testi::before{
    content:'\201C';font-family:'Cormorant Garamond',serif;font-size:5rem;
    color:var(--rose);position:absolute;top:10px;left:24px;line-height:1;opacity:0.5;
  }
  .testi blockquote{
    font-family:'Cormorant Garamond',serif;font-size:1.2rem;font-style:italic;
    line-height:1.55;color:var(--ink);position:relative;z-index:1;margin-bottom:18px;
  }
  .testi .name{
    font-family:'Cormorant Garamond',serif;font-style:italic;font-size:1.15rem;
    color:var(--gold-deep);
  }
  .testi .venue{
    font-family:'Montserrat',sans-serif;font-size:11px;letter-spacing:0.1em;
    color:var(--ink);margin-top:4px;
  }

  /* INQUIRY FORM */
  .inquiry-section{background:var(--bg)}
  .form-wrap{
    max-width:680px;margin:40px auto 0;background:var(--paper);
    padding:60px;box-shadow:0 4px 30px rgba(167,127,142,0.08);
  }
  @media(max-width:900px){.form-wrap{padding:36px 24px}}
  .form-row{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px}
  @media(max-width:900px){.form-row{grid-template-columns:1fr}}
  label{
    display:block;font-family:'Montserrat',sans-serif;font-size:10px;
    letter-spacing:0.22em;text-transform:uppercase;color:var(--ink);
    margin-bottom:6px;font-weight:600;
  }
  input, select, textarea{
    width:100%;padding:14px;border:1px solid var(--line);
    background:var(--bg);font-family:'Open Sans',sans-serif;font-size:14px;
    color:var(--ink);
  }
  input:focus, select:focus, textarea:focus{outline:none;border-color:var(--gold)}
  textarea{min-height:120px;resize:vertical;font-family:'Open Sans',sans-serif}
  .form-actions{text-align:center;margin-top:30px}
</style>
