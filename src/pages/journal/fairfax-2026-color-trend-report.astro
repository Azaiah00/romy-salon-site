  .post-meta a{color:var(--gold-deep);border-bottom:1px dotted var(--gold)}

  .post-hero-image{max-width:1200px;margin:0 auto;aspect-ratio:21/9;overflow:hidden}
  .post-hero-image img{width:100%;height:100%;object-fit:cover}

  .post-body{padding:80px 0 100px;background:var(--bg)}
  .wrap-narrow{max-width:760px;margin:0 auto;padding:0 32px}
  @media(max-width:768px){.wrap-narrow{padding:0 22px}}
  .post-body p{font-size:17px;line-height:1.85;color:var(--ink);margin-bottom:20px}
  .lede-p{font-family:'Cormorant Garamond',serif;font-size:1.4rem;font-style:italic;line-height:1.55;color:var(--mauve-deep);margin-bottom:36px;padding-bottom:36px;border-bottom:1px solid var(--line)}
