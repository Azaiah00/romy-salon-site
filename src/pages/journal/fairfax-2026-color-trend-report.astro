  .post-hero h1{font-family:'Cormorant Garamond',serif;font-size:3.6rem;font-weight:400;line-height:1.1;letter-spacing:-0.01em;color:var(--ink);max-width:880px;margin:0 auto 14px}
  @media(max-width:900px){.post-hero h1{font-size:2.4rem}}
