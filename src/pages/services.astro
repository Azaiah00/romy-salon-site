---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Services & Pricing | Romy Salon & Spa · Fairfax VA"
  description="The full menu — custom color, balayage, facials, nail design, head spa massage, bridal styling. Romy Salon & Spa · Old Town Fairfax, Virginia."
  activePage="services"
>

<!-- BANNER -->
<div class="page-banner">
  <div class="wrap">
    <div class="breadcrumb"><a href="/">Home</a> / Services</div>
    <h1>The full <span class="italic">menu</span></h1>
    <p class="subtitle">Every service is performed by Romy or her hand-selected team. Pricing starts at the figures shown — final pricing depends on length, density, and complexity.</p>
  </div>
</div>

<!-- MENU NAV -->
<div class="menu-nav">
  <div class="wrap">
    <ul>
      <li><a href="#color">Color &amp; Balayage</a></li>
      <li><a href="#hair">Cuts &amp; Styling</a></li>
      <li><a href="#facials">Facials &amp; Skin</a></li>
      <li><a href="#nails">Nail Design</a></li>
      <li><a href="#headspa">Head Spa &amp; Massage</a></li>
      <li><a href="#brows">Brows &amp; Lashes</a></li>
    </ul>
  </div>
</div>

<!-- COLOR -->
<section class="menu-section" id="color">
  <div class="wrap">
    <div class="menu-grid">
      <div class="menu-intro">
        <div class="eyebrow">— I. Color &amp; Balayage</div>
        <h2>The art of <span class="italic">color</span></h2>
        <p>Romy's specialty. From sun-kissed dimensional balayage to fantasy silver and platinum tones, every formula is mixed for you and recorded for next time. Olaplex bond-builder is included in every color service at no additional cost.</p>
        <ul class="feature-list">
          <li>Olaplex bond-builder included</li>
          <li>Custom-mixed formulas, recorded</li>
          <li>Complimentary blowout finish</li>
          <li>Free 14-day toner refresh</li>
        </ul>
        <div class="photo"><img src="/blondes4.jpg" alt="Platinum silver blonde color by Romy" loading="lazy"></div>
      </div>
      <div class="price-list card-shell">
        <div class="row"><div class="name">Single Process Color<span class="desc">All-over color refresh, root to tip</span></div><div class="price">From $135</div></div>
        <div class="row"><div class="name">Root Touch-Up<span class="desc">Color matched to existing, 4–6 week intervals</span></div><div class="price">From $95</div></div>
        <div class="row"><div class="name">Partial Highlights / Balayage<span class="desc">Crown and face-framing, freehand technique</span></div><div class="price">From $185</div></div>
        <div class="row"><div class="name">Full Highlights / Balayage<span class="desc">Full canvas, hand-painted dimension</span></div><div class="price">From $245</div></div>
        <div class="row"><div class="name">Color Correction<span class="desc">Multi-step transformation — consultation required</span></div><div class="price">From $350</div></div>
        <div class="row"><div class="name">Fantasy / Fashion Color<span class="desc">Silver, platinum, pinks, reds, jewel tones</span></div><div class="price">From $275</div></div>
        <div class="row"><div class="name">Gloss &amp; Toner<span class="desc">Refresh, add shine, or shift tone</span></div><div class="price">From $65</div></div>
        <div class="row"><div class="name">Olaplex Stand-Alone Treatment<span class="desc">No color, just bond repair</span></div><div class="price">$45</div></div>
      </div>
    </div>
  </div>
</section>

<!-- HAIR / CUTS -->
<section class="menu-section" id="hair">
  <div class="wrap">
    <div class="menu-grid">
      <div class="menu-intro">
        <div class="eyebrow">— II. Cuts &amp; Styling</div>
        <h2>Precision <span class="italic">cuts</span></h2>
        <p>Every cut begins with a consultation. We honor your hair type, texture, lifestyle, and growth pattern — not the photo you brought in (though we love seeing it). Includes shampoo, scalp massage, and blow-dry finish.</p>
        <ul class="feature-list">
          <li>Real consultation before scissors</li>
          <li>Shampoo + scalp massage included</li>
          <li>Finishing blowout + styling tutorial</li>
        </ul>
        <div class="photo"><img src="/projectHair3.jpg" alt="Caramel balayage cut and style" loading="lazy"></div>
      </div>
      <div class="price-list card-shell">
        <div class="row"><div class="name">Women's Master Cut<span class="desc">Consultation, cut, shampoo, blowout</span></div><div class="price">From $95</div></div>
        <div class="row"><div class="name">Men's Master Cut<span class="desc">Consultation, cut, shampoo, style</span></div><div class="price">From $55</div></div>
        <div class="row"><div class="name">Children's Cut (under 12)<span class="desc">Gentle, patient, fun</span></div><div class="price">$35</div></div>
        <div class="row"><div class="name">Bang / Fringe Trim<span class="desc">Complimentary between haircuts</span></div><div class="price">Free</div></div>
        <div class="row"><div class="name">Special Occasion Updo<span class="desc">For galas, parties, photo shoots</span></div><div class="price">From $125</div></div>
        <div class="row"><div class="name">Blowout &amp; Style<span class="desc">Smooth, voluminous, or beachy</span></div><div class="price">From $65</div></div>
        <div class="row"><div class="name">Keratin Smoothing Treatment<span class="desc">Frizz-control, 3–5 month results</span></div><div class="price">From $295</div></div>
        <div class="row"><div class="name">Brazilian Blowout<span class="desc">Premium smoothing, formaldehyde-free</span></div><div class="price">From $345</div></div>
      </div>
    </div>
  </div>
</section>

<!-- FACIALS -->
<section class="menu-section" id="facials">
  <div class="wrap">
    <div class="menu-grid">
      <div class="menu-intro">
        <div class="eyebrow">— III. Facials &amp; Skin</div>
        <h2>Skin, <span class="italic">restored</span></h2>
        <p>Customized facials using Image Skincare and HydraFacial-style protocols. Every service begins with skin analysis — no two facials are identical. Our estheticians are licensed and trained in advanced extractions and LED therapy.</p>
        <ul class="feature-list">
          <li>Skin analysis included</li>
          <li>Customized to your concerns</li>
          <li>Take-home product recommendations</li>
        </ul>
        <div class="photo"><img src="/SPA.jpg" alt="Facial treatment" loading="lazy"></div>
      </div>
      <div class="price-list card-shell">
        <div class="row"><div class="name">Classic Facial<span class="desc">Cleanse, exfoliate, steam, mask, moisturize — 60 min</span></div><div class="price">$150</div></div>
        <div class="row"><div class="name">Classic Glow Facial<span class="desc">Signature glow protocol with HydraFacial technique — 60 min</span></div><div class="price">$197</div></div>
        <div class="row"><div class="name">Deep Cleansing Facial<span class="desc">Oily / acne-prone, salicylic, detoxifying mask — 60 min</span></div><div class="price">$150</div></div>
        <div class="row"><div class="name">Signature Facial<span class="desc">Customized, extractions if needed, targeted mask — 90 min</span></div><div class="price">$269</div></div>
        <div class="row"><div class="name">Deluxe Facial<span class="desc">LED light therapy + gold &amp; collagen mask — 90 min</span></div><div class="price">$250</div></div>
        <div class="row"><div class="name">Teen Facial<span class="desc">Gentle cleansing, oil control, education — 30 min</span></div><div class="price">$149</div></div>
        <div class="row"><div class="name">Waxing — Brow<span class="desc">Shape, tweeze, finish</span></div><div class="price">$30</div></div>
        <div class="row"><div class="name">Waxing — Lip / Chin / Underarm</div><div class="price">From $20</div></div>
      </div>
    </div>
  </div>
</section>

<!-- NAILS -->
<section class="menu-section" id="nails">
  <div class="wrap">
    <div class="menu-grid">
      <div class="menu-intro">
        <div class="eyebrow">— IV. Nail Design</div>
        <h2>Tiny <span class="italic">jewelry</span></h2>
        <p>From classic neutrals to fantasy tones, metallic finishes, and Swarovski crystal art. Every set is finished with cuticle oil and a take-home aftercare card.</p>
        <ul class="feature-list">
          <li>Sanitized, single-use tools</li>
          <li>Swarovski crystal designs available</li>
          <li>Pedicure includes hot stone massage</li>
        </ul>
        <div class="photo"><img src="/nails-gold.jpg" alt="Luxury gold crystal nail design" loading="lazy"></div>
      </div>
      <div class="price-list card-shell">
        <div class="row"><div class="name">Classic Manicure<span class="desc">Shape, cuticle care, polish</span></div><div class="price">$45</div></div>
        <div class="row"><div class="name">Luxury Manicure<span class="desc">With hand exfoliation + paraffin treatment</span></div><div class="price">$65</div></div>
        <div class="row"><div class="name">Gel Manicure<span class="desc">2-week wear, mirror finish</span></div><div class="price">$60</div></div>
        <div class="row"><div class="name">Gel-X Extensions<span class="desc">Length without the damage of acrylic</span></div><div class="price">From $85</div></div>
        <div class="row"><div class="name">Swarovski Crystal Design<span class="desc">Hand-set crystals, per nail</span></div><div class="price">From $8/nail</div></div>
        <div class="row"><div class="name">Classic Pedicure<span class="desc">Shape, exfoliate, callus, polish, massage</span></div><div class="price">$65</div></div>
        <div class="row"><div class="name">Luxury Spa Pedicure<span class="desc">With aromatherapy + hot stone massage</span></div><div class="price">$95</div></div>
        <div class="row"><div class="name">Gel Pedicure</div><div class="price">$80</div></div>
      </div>
    </div>
  </div>
</section>

<!-- HEAD SPA -->
<section class="menu-section" id="headspa">
  <div class="wrap">
    <div class="menu-grid">
      <div class="menu-intro">
        <div class="eyebrow">— V. Head Spa &amp; Massage</div>
        <h2>Restorative <span class="italic">ritual</span></h2>
        <p>Our newest offering — a deeply therapeutic scalp + neck + shoulder treatment that's gone viral on TikTok for good reason. Pair with any service, or come for it alone.</p>
        <ul class="feature-list">
          <li>Scalp analysis under magnification</li>
          <li>Deep conditioning + aromatherapy</li>
          <li>Includes neck &amp; shoulder release</li>
        </ul>
        <div class="photo"><img src="/massage.jpg" alt="Head spa massage" loading="lazy"></div>
      </div>
      <div class="price-list card-shell">
        <div class="row"><div class="name">Express Head Spa<span class="desc">Scalp massage + deep conditioning — 30 min</span></div><div class="price">$75</div></div>
        <div class="row"><div class="name">Signature Head Spa<span class="desc">Full scalp + neck + shoulder, aromatherapy — 60 min</span></div><div class="price">$135</div></div>
        <div class="row"><div class="name">Luxury Head Spa Ritual<span class="desc">With foot soak, hot towel, gua sha — 90 min</span></div><div class="price">$210</div></div>
        <div class="row"><div class="name">Add to any service<span class="desc">When booked with hair or facial</span></div><div class="price">$45</div></div>
      </div>
    </div>
  </div>
</section>

<!-- BROWS -->
<section class="menu-section" id="brows">
  <div class="wrap">
    <div class="menu-grid">
      <div class="menu-intro">
        <div class="eyebrow">— VI. Brows &amp; Lashes</div>
        <h2>Frame the <span class="italic">face</span></h2>
        <p>Precision brow design + lash extensions for everyday wear or special events. Bridal lash sets available with bridal packages.</p>
      </div>
      <div class="price-list card-shell">
        <div class="row"><div class="name">Brow Shape &amp; Wax</div><div class="price">$30</div></div>
        <div class="row"><div class="name">Brow Tint</div><div class="price">$35</div></div>
        <div class="row"><div class="name">Brow Lamination</div><div class="price">$75</div></div>
        <div class="row"><div class="name">Lash Lift &amp; Tint</div><div class="price">$95</div></div>
        <div class="row"><div class="name">Classic Lash Extensions Full Set</div><div class="price">From $165</div></div>
        <div class="row"><div class="name">Hybrid Lash Extensions Full Set</div><div class="price">From $195</div></div>
        <div class="row"><div class="name">Volume Lash Extensions Full Set</div><div class="price">From $235</div></div>
        <div class="row"><div class="name">Lash Fill (2-3 weeks)</div><div class="price">From $85</div></div>
      </div>
    </div>
  </div>
</section>

<!-- PACKAGES -->
<section class="packages-section">
  <div class="wrap">
    <div class="section-eyebrow">Curated Packages</div>
    <h2 class="section-h">Signature <span class="italic">experiences</span></h2>
    <div class="ornament"></div>
    <p class="section-sub">Multi-service rituals — designed to deliver more than the sum of their parts.</p>

    <div class="pkg-grid">
      <div class="pkg">
        <div class="name">The Color <span class="italic">Journey</span></div>
        <div class="duration">— 3 hours · our signature</div>
        <div class="price">$375</div>
        <p>Consultation · Olaplex treatment · custom color · gloss · head spa · blowout. Espresso or champagne included.</p>
        <a href="https://booking.mangomint.com/romysalonandspa" target="_blank" rel="noopener" class="btn">Book the Journey</a>
      </div>
      <div class="pkg">
        <div class="name">The Reset <span class="italic">Day</span></div>
        <div class="duration">— 4 hours · for the depleted</div>
        <div class="price">$485</div>
        <p>Signature facial · luxury manicure · luxury pedicure · signature head spa. Built for the day before a big event — or after a hard week.</p>
        <a href="https://booking.mangomint.com/romysalonandspa" target="_blank" rel="noopener" class="btn">Book Reset</a>
      </div>
      <div class="pkg">
        <div class="name">The Bride <span class="italic">Suite</span></div>
        <div class="duration">— half day · before the aisle</div>
        <div class="price">$625</div>
        <p>Bridal trial · day-of hair &amp; makeup · luxury manicure · brow shape. Private styling room available for the bride &amp; her party.</p>
        <a href="/bridal" class="btn">See Bridal</a>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="final-cta">
  <div class="wrap">
    <h2>Have a service in <span class="italic">mind?</span></h2>
    <p>Booking is online via Mangomint. Same-week appointments often available.</p>
    <a href="https://booking.mangomint.com/romysalonandspa" target="_blank" rel="noopener" class="btn lg gold">Book Online</a>
    <a href="tel:+15714075801" class="btn lg ghost" style="margin-left:8px">Or call 571.407.5801</a>
  </div>
</section>

</BaseLayout>

<style>
  .menu-nav{
    background:var(--bg);padding:30px 0;border-bottom:1px solid var(--line);
    position:sticky;top:69px;z-index:20;
    background:rgba(253,248,244,0.96);backdrop-filter:blur(14px);
  }
  .menu-nav ul{
    list-style:none;display:flex;gap:36px;justify-content:center;flex-wrap:wrap;padding:0;
  }
  .menu-nav a{
    font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600;
    letter-spacing:0.22em;text-transform:uppercase;color:var(--ink);
    padding-bottom:6px;border-bottom:1px solid transparent;transition:all 0.2s;
  }
  .menu-nav a:hover{border-bottom-color:var(--gold);color:var(--gold-deep)}

  .menu-section{padding:80px 0;background:var(--bg)}
  .menu-section:nth-of-type(even){background:var(--bg-soft)}
  .menu-grid{display:grid;grid-template-columns:5fr 7fr;gap:60px;align-items:start}
  @media(max-width:900px){.menu-grid{grid-template-columns:1fr;gap:30px}}
  .menu-intro{position:sticky;top:170px;align-self:start}
  .menu-intro .eyebrow{
    color:var(--gold-deep);font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600;
    letter-spacing:0.3em;text-transform:uppercase;margin-bottom:14px;
  }
  .menu-intro h2{
    font-family:'Cormorant Garamond',serif;font-size:2.6rem;font-weight:400;
    line-height:1.05;margin-bottom:18px;color:var(--ink);
  }
  .menu-intro h2 .italic{font-style:italic}
  .menu-intro p{
    color:var(--ink);font-size:15px;line-height:1.8;margin-bottom:20px;
  }
  .menu-intro .photo{margin-top:24px;overflow:hidden}
  .menu-intro .photo img{width:100%;display:block}

  .menu-intro .feature-list{
    margin-top:24px;padding-left:0;list-style:none;
  }
  .menu-intro .feature-list li{
    padding:8px 0;border-bottom:1px dotted var(--line);
    font-family:'Cormorant Garamond',serif;font-style:italic;
    font-size:1.05rem;color:var(--ink);
  }
  .menu-intro .feature-list li::before{content:'\2740 ';color:var(--rose)}

  .price-list{padding:40px}
  @media(max-width:900px){.price-list{padding:28px}}

  /* PACKAGES */
  .packages-section{
    background:var(--ink);color:var(--bg);padding:120px 0;
  }
  .packages-section .section-eyebrow{color:var(--gold)}
  .packages-section .section-h{color:var(--bg)}
  .packages-section .section-sub{color:var(--bg);opacity:0.85}
  .packages-section .ornament::after{background:var(--ink)}
  .pkg-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:50px}
  @media(max-width:900px){.pkg-grid{grid-template-columns:1fr}}
  .pkg{
    border:1px solid rgba(214,185,129,0.3);padding:40px 32px;text-align:center;
    transition:all 0.3s;
  }
  .pkg:hover{background:rgba(214,185,129,0.05);border-color:var(--gold)}
  .pkg .name{
    font-family:'Cormorant Garamond',serif;font-size:1.8rem;font-weight:500;
    color:var(--bg);margin-bottom:8px;
  }
  .pkg .name .italic{font-style:italic;color:var(--gold-light)}
  .pkg .duration{
    font-family:'Montserrat',sans-serif;font-size:10px;letter-spacing:0.25em;
    text-transform:uppercase;color:var(--gold);margin-bottom:24px;
  }
  .pkg .price{
    font-family:'Cormorant Garamond',serif;font-size:3rem;font-style:italic;
    color:var(--gold);line-height:1;margin-bottom:24px;
  }
  .pkg p{color:var(--bg);opacity:0.8;font-size:14px;line-height:1.65;margin-bottom:28px}
  .pkg .btn{background:transparent;color:var(--bg);border-color:var(--gold)}
  .pkg .btn:hover{background:var(--gold);color:var(--ink)}

  /* CTA */
  .final-cta{
    text-align:center;background:linear-gradient(135deg,var(--rose-pale) 0%,var(--bg-cream) 100%);
    padding:100px 0;
  }
  .final-cta h2{
    font-family:'Cormorant Garamond',serif;font-size:3rem;font-weight:400;
    margin-bottom:18px;color:var(--ink);
  }
  .final-cta h2 .italic{font-style:italic}
  .final-cta p{
    font-family:'Cormorant Garamond',serif;font-size:1.3rem;font-style:italic;
    color:var(--ink);margin-bottom:36px;max-width:560px;margin-left:auto;margin-right:auto;
  }
</style>
