---
import BaseLayout from '../layouts/BaseLayout.astro';
import BeforeAfter from '../components/BeforeAfter.astro';

// Before/after transformations. The "after" images are real client results
// hosted locally in /public. The "before" images are AI-simulated from the same
// shot purely to illustrate the starting point — labeled as such for honesty.
// To harden for production, download each `before` URL into /public and swap the
// path (see the note at the bottom of this file).
const transformations = [
  {
    before: 'https://d8j0ntlcm91z4.cloudfront.net/user_3AKOARGKGNgk3YWyVLO4xafDr8w/hf_20260529_132041_96fba228-84d4-4ff0-a113-0c782605851f.png',
    after: '/blondes-platinum.jpg',
    alt: 'Dark grown-out hair to icy platinum-silver balayage',
    label: 'Platinum & Silver Balayage',
  },
  {
    before: 'https://d8j0ntlcm91z4.cloudfront.net/user_3AKOARGKGNgk3YWyVLO4xafDr8w/hf_20260529_132045_c6f2680e-880c-44fe-8f17-5c33a13e5374.png',
    after: '/balayage-blonde.jpg',
    alt: 'Flat brown hair to dimensional sun-kissed balayage',
    label: 'Dimensional Balayage',
  },
  {
    before: 'https://d8j0ntlcm91z4.cloudfront.net/user_3AKOARGKGNgk3YWyVLO4xafDr8w/hf_20260529_132049_30f1b639-9f64-463a-924f-e6c7aa35cafe.png',
    after: '/color-vivid-red.jpg',
    alt: 'Dull natural brown to vivid copper-red',
    label: 'Vivid Copper-Red',
  },
];

const services = [
  { name: 'Custom Color & Balayage', price: 'From $185', img: '/blondes4.jpg', desc: "From sun-kissed dimensional balayage to fantasy silver and platinum tones — color crafted from theory, not from a box." },
  { name: 'Signature Facials', price: 'From $269', img: '/SPA.jpg', desc: 'Customized treatments using HydraFacial and our signature glow protocols. From the Classic ($150) to the Deluxe with LED & gold collagen ($250).' },
  { name: 'Master Cuts & Styling', price: 'From $95', img: '/projectHair3.jpg', desc: 'Precision cuts that honor your hair type, texture, and lifestyle. Every cut begins with a real consultation.' },
  { name: 'Luxury Nail Design', price: 'From $85', img: '/nails-gold.jpg', desc: 'From classic neutrals to fantasy tones, metallic finishes, and Swarovski crystal art — each set is a tiny piece of jewelry.' },
  { name: 'Head Spa & Massage', price: 'From $135', img: '/massage.jpg', desc: 'A deeply restorative ritual: scalp massage, aromatherapy, deep conditioning, neck & shoulder release. Pair with any service.' },
