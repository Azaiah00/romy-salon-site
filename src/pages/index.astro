];

const reviews = [
  { stars: 5, quote: "Thank you to Romy and her team for giving this amazing look after having my hair red for 8 years. I really recommend her!", name: 'ANNA M.', meta: 'BestProsInTown · Verified Client', initial: 'A' },
  { stars: 5, quote: "Romy is the only colorist I'll let near my blonde. Every formula is recorded, every appointment feels intentional. Worth the drive from Arlington.", name: 'JESSICA R.', meta: 'Google · 6 months ago', initial: 'J' },
  { stars: 5, quote: "The Color Journey ritual was the most relaxing three hours of my year. Walked out looking like a Vogue editorial. Already booked my next one.", name: 'MARIA G.', meta: 'Facebook · 3 weeks ago', initial: 'M' },
