---
/**
 * BeforeAfter — draggable before/after reveal slider.
 *
 * Props:
 *  - before : image URL shown on the LEFT of the handle (the "before" state)
 *  - after  : image URL shown on the RIGHT of the handle (the finished result)
 *  - alt    : accessible description of the transformation
 *  - start  : initial handle position 0–100 (default 50)
 *
 * Interaction: pointer events on the stage drive the reveal, so tap-and-drag
 * works on touch (mobile) as well as mouse. A visually-hidden <input type="range">
 * remains for keyboard / screen-reader operation.
 */
interface Props {
  before: string;
  after: string;
  alt: string;
  start?: number;
}
const { before, after, alt, start = 50 } = Astro.props;
---

<figure class="ba-slider" style={`--pos:${start}%`}>
  <div class="ba-stage">
    <!-- AFTER (base layer, full width) -->
    <img class="ba-img ba-after" src={after} alt={`${alt} — after`} loading="lazy" draggable="false" />
    <!-- BEFORE (clipped overlay) -->
    <div class="ba-before-clip">
      <img class="ba-img ba-before" src={before} alt={`${alt} — before (digitally simulated)`} loading="lazy" draggable="false" />
    </div>

    <span class="ba-tag ba-tag-before">Before</span>
    <span class="ba-tag ba-tag-after">After</span>

    <!-- Handle -->
    <div class="ba-handle" aria-hidden="true">
      <span class="ba-line"></span>
      <span class="ba-knob">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
          <polyline points="9 18 3 12 9 6" transform="translate(12 0)"></polyline>
        </svg>
      </span>
    </div>

    <!-- Keyboard / screen-reader control (pointer handled on the stage) -->
    <input class="ba-range" type="range" min="0" max="100" value={start}
           aria-label={`Reveal slider: ${alt}. Use arrow keys, or drag, to compare before and after.`} />
  </div>
</figure>

<style>
  .ba-slider{ margin:0; }
  .ba-stage{
    position:relative; width:100%; aspect-ratio:3/4; overflow:hidden;
    background:var(--bg-cream); user-select:none;
    /* allow vertical page scroll, but let horizontal drags move the slider */
    touch-action:pan-y; cursor:ew-resize; container-type:inline-size;
    box-shadow:0 2px 24px rgba(167,127,142,0.10);
  }
  .ba-img{
    position:absolute; inset:0; width:100%; height:100%;
    object-fit:cover; display:block; pointer-events:none; -webkit-user-drag:none;
  }
  .ba-before-clip{
    position:absolute; inset:0; width:var(--pos); overflow:hidden; will-change:width;
  }
  /* keep the before image full-bleed inside the clip so it doesn't squash */
  .ba-before-clip .ba-before{ width:100cqw; }

  .ba-tag{
    position:absolute; top:16px; z-index:3; pointer-events:none;
    font-family:'Montserrat',sans-serif; font-size:10px; font-weight:600;
    letter-spacing:0.22em; text-transform:uppercase; color:var(--ink);
    background:rgba(253,248,244,0.92); padding:6px 12px; backdrop-filter:blur(2px);
  }
  .ba-tag-before{ left:16px; }
  .ba-tag-after{ right:16px; }

  .ba-handle{
    position:absolute; top:0; bottom:0; left:var(--pos); z-index:4;
    transform:translateX(-50%); pointer-events:none;
  }
  .ba-line{
    position:absolute; top:0; bottom:0; left:50%; width:2px;
    transform:translateX(-50%); background:var(--paper);
    box-shadow:0 0 0 1px rgba(0,0,0,0.06);
  }
  .ba-knob{
    position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
    width:46px; height:46px; border-radius:50%;
    background:var(--paper); color:var(--gold-deep);
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 4px 16px rgba(167,127,142,0.32); border:1px solid var(--gold);
  }
  /* larger touch target for the knob on small screens */
  @media(max-width:900px){
    .ba-knob{ width:52px; height:52px; }
  }

  /* keyboard control only — visually hidden, pointer events pass through to the stage */
  .ba-range{
    position:absolute; left:0; bottom:0; width:100%; height:2px; margin:0;
    opacity:0; pointer-events:none; z-index:5;
    -webkit-appearance:none; appearance:none; background:transparent;
  }
  .ba-slider:focus-within .ba-knob{
    box-shadow:0 0 0 4px var(--rose-pale),0 4px 16px rgba(167,127,142,0.32);
  }
</style>

<script is:inline>
  // Pointer-driven reveal — works for touch + mouse + pen. Runs once for all sliders.
  (function () {
    function init() {
      document.querySelectorAll('.ba-slider').forEach(function (slider) {
        var stage = slider.querySelector('.ba-stage');
        var range = slider.querySelector('.ba-range');
        if (!stage) return;

        function set(p) {
          p = p < 0 ? 0 : (p > 100 ? 100 : p);
          slider.style.setProperty('--pos', p + '%');
          if (range) range.value = String(p);
        }
        function fromEvent(e) {
          var r = stage.getBoundingClientRect();
          return ((e.clientX - r.left) / r.width) * 100;
        }

        var dragging = false;
        stage.addEventListener('pointerdown', function (e) {
          dragging = true;
          if (stage.setPointerCapture) { try { stage.setPointerCapture(e.pointerId); } catch (_) {} }
          set(fromEvent(e));
        });
        stage.addEventListener('pointermove', function (e) {
          if (dragging) set(fromEvent(e));
        });
        function end() { dragging = false; }
        stage.addEventListener('pointerup', end);
        stage.addEventListener('pointercancel', end);

        // keyboard (arrow keys on the hidden range)
        if (range) range.addEventListener('input', function () {
          slider.style.setProperty('--pos', range.value + '%');
        });
      });
    }
    if (document.readyState !== 'loading') init();
    else document.addEventListener('DOMContentLoaded', init);
  })();
</script>
